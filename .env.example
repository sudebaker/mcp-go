# MCP Orchestrator Environment Configuration
# Copy this file to .env and customize for your deployment.

# =============================================================================
# MCP TOOLKIT SELECTION
# =============================================================================
# Choose which subset of tools the server exposes to clients.
# Toolkits are defined in configs/toolkits/<name>.yaml
#
# Options:
#   default      → 14 general-purpose tools (echo, weather, kb, web, etc.)
#   development  → 10 dev tools + core (opencode_context, codebase_scan, etc.)
#   (unset)      → All available tools (backward compatible)
#
# Example:
#   MCP_TOOLKIT=default
#   MCP_TOOLKIT=development
#
#MCP_TOOLKIT=default

# =============================================================================
# LLM / API CONFIGURATION
# =============================================================================

# Local Ollama instance (default: http://localhost:11434)
#LLM_API_URL=http://localhost:11434

# Remote Ollama instance (VPN, Tailscale, LAN)
#REMOTE_OLLAMA_URL=http://your-remote-host:11434

# Default LLM model for tools that require one
#LLM_MODEL=llava

# API Keys for cloud providers (only set what you use)
#OPENROUTER_API_KEY=
#OPENAI_API_KEY=
#MISTRAL_API_KEY=
#GROQ_API_KEY=
#DEEPSEEK_API_KEY=
#BRAVE_SEARCH_API_KEY=

# =============================================================================
# DATABASE & STORAGE
# =============================================================================

# PostgreSQL connection string
#DATABASE_URL=postgresql://mcp:password@localhost:5432/knowledge

# Redis URL
#REDIS_URL=redis://localhost:6379/0

# RustFS / S3-compatible storage
#RUSTFS_ENDPOINT=rustfs:9000
#RUSTFS_ACCESS_KEY_ID=rustfsadmin
#RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
#RUSTFS_PUBLIC_URL=

# =============================================================================
# NETWORK & SECURITY
# =============================================================================

# SSRF allowlist for internal services
#SSRF_ALLOWLIST=rustfs

# SearXNG instance URL
#SEARXNG_URL=http://searxng:8080

# Browserless instance for headless scraping
#BROWSERLESS_URL=http://browserless:3000
#BROWSERLESS_TOKEN=

# =============================================================================
# SERVICE INTEGRATION
# =============================================================================

# Whisper transcription service
#WHISPER_URL=http://whisper:8000

# Python unbuffered output for Docker logs
PYTHONUNBUFFERED=1
