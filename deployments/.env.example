# MCP Orchestrator — Configuración de Entorno
# Copia este archivo a .env y rellena los valores obligatorios.
#
# Los valores por defecto funcionan para un despliegue local estándar.
# Los marcados con [REQUERIDO] deben configurarse obligatoriamente.
#
# Uso: docker-compose --env-file .env -f deployments/docker-compose.yml up

# =============================================================================
# MCP TOOLSET
# =============================================================================
# default | development | ocu-investigacion | (vacío = todos)
# Nota: el toolset ocu-investigacion requiere levantar Memgraph y OpenSearch:
#   docker compose --profile ocu-investigacion up -d
MCP_TOOLSET=default

# =============================================================================
# RED PÚBLICA [REQUERIDO]
# =============================================================================
# URL pública o IP accesible desde el exterior (incluir puerto si no es 80)
BASE_URL=http://TU_IP_O_DOMINIO:8080

# =============================================================================
# LLM / API
# =============================================================================
LLM_API_URL=http://ollama:11434
LLM_MODEL=llama3
# LLM_VISION_API_URL=
# OPENROUTER_API_KEY=
LLM_API_FORMAT=ollama

# =============================================================================
# BASE DE DATOS
# =============================================================================
DATABASE_URL=postgresql://mcp:***@postgres:5432/knowledge
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp
POSTGRES_DB=knowledge

# =============================================================================
# OCu INVESTIGACIÓN CRIMINAL
# =============================================================================
MEMGRAPH_URL=bolt://memgraph:7687
OPENSEARCH_URL=http://opensearch:9200
# MEMGRAPH_USERNAME=
# MEMGRAPH_PASSWORD=

# =============================================================================
# RUSTFS / S3 [REQUERIDO]
# =============================================================================
RUSTFS_ENDPOINT=rustfs:9000
RUSTFS_PUBLIC_URL=http://TU_IP_O_DOMINIO:9000
RUSTFS_ACCESS_KEY_ID=rustfsadmin
RUSTFS_SECRET_ACCESS_KEY=rustfsadmin
# S3_BUCKET_NAME no se usa — cada tool hardcodea su bucket
DOWNLOAD_URL_EXPIRY_HOURS=24

# =============================================================================
# CRAWL4AI [REEMPLAZA BROWSERLESS — scraper LLM-friendly sin API key]
# =============================================================================
# URL del servicio (accede desde la red Docker interna)
CRAWL4AI_URL=http://crawl4ai:11235
# Token para autenticacion (genera con: openssl rand -hex 32)
# Si esta vacio, el servicio solo acepta conexiones desde 127.0.0.1
CRAWL4AI_TOKEN=

# =============================================================================
# WHISPER / AUDIO
# =============================================================================
WHISPER_URL=http://whisper:8000

# =============================================================================
# SEGURIDAD
# =============================================================================
SSRF_ALLOWLIST=rustfs
# MCP_UPLOAD_API_KEY=

# =============================================================================
# ADMIN
# =============================================================================
# Clave para autenticacion en /admin/kb/* endpoints (borrado de datos KB).
# Si no se configura, los endpoints devuelven 503 Service Unavailable.
# ADMIN_API_KEY=

# =============================================================================
# PYTHON
# =============================================================================
PYTHONUNBUFFERED=1
